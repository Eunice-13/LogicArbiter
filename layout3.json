  "notes": [
    {
      "id": "note_9000",
      "text": "GAME OF THE GENERALS - BATTLE ARBITER",
      "x": -700,
      "y": -1160,
      "w": 950,
      "h": 40,
      "color": "#000000",
      "fontSize": 18,
      "fontFamily": "Arial",
      "bold": true,
      "italic": false,
      "underline": false
    },
    {
      "id": "note_9001",
      "text": "ENCODING: Flag=0000, Private=0001, Sergeant=0010, 2LT=0011, 1LT=0100, CPT=0101, MAJ=0110, LTC=0111, COL=1000, Brig=1001, MajGen=1010, LtGen=1011, 4-Star=1100, 5-Star=1101, Spy=1110. 1111 is unused.",
      "x": -700,
      "y": -1120,
      "w": 950,
      "h": 80,
      "color": "#000000",
      "fontSize": 12,
      "fontFamily": "Arial",
      "bold": false,
      "italic": false,
      "underline": false
    },
    {
      "id": "note_9002",
      "text": "TURN: set exactly one of Turn_A / Turn_B HIGH only when both pieces are Flags. The attacker wins Flag-vs-Flag; both LOW is undefined/no-winner.",
      "x": -700,
      "y": -1040,
      "w": 950,
      "h": 60,
      "color": "#000000",
      "fontSize": 12,
      "fontFamily": "Arial",
      "bold": false,
      "italic": false,
      "underline": false
    },
    {
      "id": "note_9003",
      "text": "LOGIC: A_WIN=(A>B)*NOT(Pvt_B*Spy_A)+(Pvt_A*Spy_B)+FlagVsFlag*Turn_A; B_WIN=(A<B)*NOT(Pvt_A*Spy_B)+(Pvt_B*Spy_A)+FlagVsFlag*Turn_B; TIE=EQ*NOT FlagVsFlag*NOT(Pvt_A*Spy_B)*NOT(Pvt_B*Spy_A).",
      "x": -700,
      "y": -960,
      "w": 950,
      "h": 80,
      "color": "#000000",
      "fontSize": 12,
      "fontFamily": "Arial",
      "bold": false,
      "italic": false,
      "underline": false
    },
    {
      "id": "note_9004",
      "text": "INPUTS: 10k pull-downs. OUTPUT LEDs: 330R series resistors. POWER: regulated 5V; 74HC logic below 5.5V.",
      "x": -700,
      "y": 650,
      "w": 700,
      "h": 60,
      "color": "#000000",
      "fontSize": 12,
      "fontFamily": "Arial",
      "bold": false,
      "italic": false,
      "underline": false
    },
    {
      "id": "note_9005",
      "text": "3-LED DISPLAY: A_Win / Tie / B_Win. Flag and final results are computed internally.",
      "x": 300,
      "y": -1270,
      "w": 1100,
      "h": 40,
      "color": "#000000",
      "fontSize": 12,
      "fontFamily": "Arial",
      "bold": false,
      "italic": false,
      "underline": false
    },
